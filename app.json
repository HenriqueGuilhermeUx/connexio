{
  "expo": {
    "name": "Connexio",
    "slug": "connexio",
    "owner": "henrriquenexa",
    "version": "0.4.2",
    "orientation": "portrait",
    "scheme": "connexio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "icon": "./assets/connexio-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.alternativeventures.connexio",
      "icon": "./assets/connexio-app-icon.png"
    },
    "android": {
      "versionCode": 14,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.com.alternativeventures.connexio",
      "icon": "./assets/connexio-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/connexio-adaptive-foreground.png",
        "backgroundColor": "#E4B64E",
        "monochromeImage": "./assets/connexio-adaptive-foreground.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/connexio-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O Connexio usa a câmera para ler a carteirinha digital e registrar presença nas sessões.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E4B64E",
          "defaultChannel": "connexio-loja"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cdcb129b-043c-4823-be6f-4e7dc0b7ddeb"
      }
    }
  }
}
